#include "cuda_runtime.h"
#include "device_launch_parameters.h"
#include <stdlib.h>
#include<stdio.h>

#define BSIZE_ 32
#define SSIZE_ 32
#define OUTSIZE_ 28
#define KERNELSIZE_ 5

__global__ void lenetforward(float* input, float* output, float* kernel, float* bias, int bsize, int ssize, int outsize, int kernelsize) {
    int idx = threadIdx.x + blockIdx.x * blockDim.x;
    int workx = idx / 32;
    int worky = idx % 32; int b; int s; int o; int ox; int oy; 
    int workyx = worky / kernelsize; 
    int workyy = worky % kernelsize; 
    float cache = 0.0f;
    int in_size = outsize + kernelsize - 1;
    //extern __shared__ float scache[];

    for (; workx < outsize * outsize * ssize * bsize; workx += (gridDim.x * blockDim.x)>>5) {
        b = workx / (ssize * outsize * outsize);
        s = (workx - b * ssize * outsize * outsize) / (outsize * outsize);
        ox = (workx - (b * ssize + s) * outsize * outsize) / outsize;
        oy = workx - (((b * ssize + s) * outsize + ox) * outsize);
        if (worky < kernelsize * kernelsize) {
            cache = input[((s * in_size) + ox + workyx) * in_size + oy + workyy] * kernel[(((b * ssize) + s) * kernelsize + workyx) * kernelsize + workyy];
        }
        if (worky == kernelsize * kernelsize) {
            cache = bias[(b * ssize) + s];
        }
        for (int offset = 16; offset >= 1; offset >>= 1) {
            cache += __shfl_down_sync(0xffffffff, cache, offset);
        }
        
        if (worky == 0) {
            //scache[((b * ssize + s) * outsize + ox) * outsize + oy] = cache;
            output[((b * ssize + s) * outsize + ox) * outsize + oy] = cache;

        }
    }
}
int main(){
    size_t insize = sizeof(float) * SSIZE_ * (OUTSIZE_ + KERNELSIZE_ - 1) * (OUTSIZE_ + KERNELSIZE_ - 1); size_t outsize = sizeof(float) * BSIZE_ * SSIZE_ * OUTSIZE_ * OUTSIZE_;
    size_t kernelsize = sizeof(float) * BSIZE_ * SSIZE_ * KERNELSIZE_ * KERNELSIZE_; size_t biassize = sizeof(float) * BSIZE_ * SSIZE_;
    float* input; float* output; float* kernel; float* bias;
    cudaMalloc(&input, insize); cudaMalloc(&output, outsize); cudaMalloc(&kernel, kernelsize); cudaMalloc(&bias, biassize);
    float* h_input = (float*)malloc(insize); float* h_output = (float*)malloc(outsize); float* h_kernel = (float*)malloc(kernelsize); float* h_bias = (float*)malloc(biassize);
    //prepare data
    for (int i = 0; i < SSIZE_ * (OUTSIZE_ + KERNELSIZE_ - 1) * (OUTSIZE_ + KERNELSIZE_ - 1); i++) {
        h_input[i] = 1;
    }for (int i = 0; i < BSIZE_ * SSIZE_ * KERNELSIZE_ * KERNELSIZE_; i++) {
        h_kernel[i] = 1;
    }for (int i = 0; i < BSIZE_ * SSIZE_; i++) {
        h_bias[i] = 1;
    }
    cudaMemcpy(input, h_input, insize, cudaMemcpyHostToDevice);
    //cudaMemcpy(output, h_output, outsize, cudaMemcpyHostToDevice);
    cudaMemcpy(kernel, h_kernel, kernelsize, cudaMemcpyHostToDevice);
    cudaMemcpy(bias, h_bias, biassize, cudaMemcpyHostToDevice);


    int total_warps = BSIZE_ * SSIZE_ * OUTSIZE_ * OUTSIZE_;
    int total_threads = total_warps * 32;
    int block_size = 256;
    int grid_size = (total_threads + block_size - 1) / block_size;
    //size_t exsize = BSIZE_ * SSIZE_ * OUTSIZE_ * OUTSIZE_ * sizeof(float);
    // launch
    lenetforward <<<grid_size, block_size/*, exsize */>> > (input, output, kernel, bias, BSIZE_, SSIZE_, OUTSIZE_, KERNELSIZE_);
    cudaError_t err = cudaGetLastError();
    if (err != cudaSuccess) { printf("CUDA Error: %s\n", cudaGetErrorString(err)); }
    cudaDeviceSynchronize();

    cudaMemcpy(h_output, output, outsize, cudaMemcpyDeviceToHost);
    //check results
    /*for (int i = 0; i < BSIZE_ * SSIZE_ * OUTSIZE_ * OUTSIZE_; i++) {
        printf("h_output[%d]: %f\n", i, h_output[i]);
    }*/
    
    for (int i = 0; i < 100; i++) {
        printf("h_output[%d]: %f\n", i, h_output[i]);
    }
    free(h_input); free(h_output); free(h_kernel); free(h_bias);
    cudaFree(input); cudaFree(output); cudaFree(kernel); cudaFree(bias);
    return 0;
}


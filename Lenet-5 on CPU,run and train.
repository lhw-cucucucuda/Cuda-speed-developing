void pool1(){
    float lz = 0.0f;
    short pos = 0;
    for(int i = 0; i < 7; i++){
        for(int j = 0; j < 14; j++){
            for(int k = 0; k < 14; k++){
                for(int m = 0; m < 2; m++){
                    for(int n = 0; n < 2; n++){
                        if(lz < conv1_out[i][2*j+m][2*k+n]){
                            lz = conv1_out[i][2*j+m][2*k+n];
                            pos = m*2 + n;
                }}}pool1_pos[i][j][k] = pos;
                pool1_out[i][j][k][0] = lz;
                lz = 0.0f; pos = 0;
    }}}                        
}
void conv2(){
    float sum = 0;
    for(int a = 0; a < 10; a++){
        for(int c = 0; c < 10; c++){
            for(int d = 0; d < 10; d++){
                relupos2[a][c][d] = 1;
                sum = conv2_b[a];
                for(int b = 0; b < 7; b++){
                    for(int e = 0; e < 5; e++){
                        for(int f = 0; f < 5; f++){
                            sum += conv2_w[a][b][e][f] * pool1_out[b][c+e][d+f][0];
                }}}
                conv2_out[a][c][d] = sum;
                if(conv2_out[a][c][d] < 0) {conv2_out[a][c][d] = 0; relupos2[a][c][d] = 0;}//relu
    }}}
}
void pool2(){
    float lz = 0.0f;
    short pos = 0;
    for(int i = 0; i < 10; i++){
        for(int j = 0; j < 5; j++){
            for(int k = 0; k < 5; k++){
                for(int m = 0; m < 2; m++){
                    for(int n = 0; n < 2; n++){
                        if(lz < conv2_out[i][2*j+m][2*k+n]){
                            lz = conv2_out[i][2*j+m][2*k+n];
                            pos = m*2 + n;
                }}}pool2_pos[i][j][k] = pos;
                pool2_out[i][j][k][0] = lz;
                lz = 0.0f; pos = 0;
    }}}                        
}
void conv3(){
    float sum = 0;
    for(int a = 0; a < 20; a++){
        for(int c = 0; c < 1; c++){
            for(int d = 0; d < 1; d++){
                relupos3[a][c][d] = 1;
                sum = conv3_b[a];
                for(int b = 0; b < 10; b++){
                    for(int e = 0; e < 5; e++){
                        for(int f = 0; f < 5; f++){
                            sum += conv3_w[a][b][e][f] * pool2_out[b][c+e][d+f][0];
                }}}
                conv3_out[a][c][d][0] = sum;
                if(conv3_out[a][c][d][0] < 0) {conv3_out[a][c][d][0] = 0; relupos3[a][c][d] = 0;}//relu
    }}}
}
void flt(){
    for(int i = 0; i < 20; i++){
        flatten[i][0] = conv3_out[i][0][0][0];
    }
}        
void mlp1(){
    float sum = 0.0f;
    for(int i = 0; i < 30; i++){
        relupos4[i] = 1;//init
        sum = fc1_b[i];
        for(int j = 0; j < 20; j++){
             sum += fc1_w[i][j] * flatten[j][0];
        }if(sum < 0){sum = 0; relupos4[i] = 0;}
        fc1_out[i][0] = sum;
    }         
}
void mlp2(){
    for(int i = 0; i < 3; i++){
        relupos5[i] = 1;   // 永远为 1，没有截断
        float sum = fc2_b[i];
        for(int j = 0; j < 30; j++){
            sum += fc2_w[i][j] * fc1_out[j][0];
        }
        output[i][0] = sum;
    }
}
float losscalc(float output, float standard){
    return output - standard;
}  
void backward1(){
    short pos1 = 0;
    short pos2 = 0;
    float loss = 0.0f;
    for(int i = 0; i < 7; i++){
        for(int j = 0; j < 1; j++){
            for(int k = 0; k < 14; k++){
                for(int l = 0; l < 14; l++){
                    pos1 = pool1_pos[i][k][l] /2;
                    pos2 = pool1_pos[i][k][l] %2;
                    loss = pool1_out[i][k][l][1];
                    for(int c = 0; c < 5; c++){
                        for(int d = 0; d < 5; d++){
                            //conv1_out[i][2*k+pos1][2*l+pos2] += conv1_w[i][j][c][d]*input[j][2*k+pos1+c][2*l+pos2+d]
                            if(relupos1[i][2*k+pos1][2*l+pos2] == 1) conv1_w[i][j][c][d] -= loss * input[j][2*k+pos1+c][2*l+pos2+d] * lr;
                            //input[j][2*k+pos1+c][2*l+pos2+d][1] += loss * conv1_w[i][j][c][d] * relupos1[i][2*k+pos1][2*l+pos2];
                    }}
                   if(relupos1[i][2*k+pos1][2*l+pos2] == 1) conv1_b[i] -= loss * lr;
    }}}}
}   
void backward2(){
    short pos1 = 0;
    short pos2 = 0;
    float loss = 0.0f;
    for(int m = 0; m < 7; m++){
        for(int a = 0; a < 14; a++){
            for(int b = 0; b < 14; b++){
                pool1_out[m][a][b][1] = 0;
    }}}
    for(int i = 0; i < 10; i++){
        for(int j = 0; j < 7; j++){
            for(int k = 0; k < 5; k++){
                for(int l = 0; l < 5; l++){
                    pos1 = pool2_pos[i][k][l] /2;
                    pos2 = pool2_pos[i][k][l] %2;
                    loss = pool2_out[i][k][l][1];
                    for(int c = 0; c < 5; c++){
                        for(int d = 0; d < 5; d++){
                            //conv1_out[i][2*k+pos1][2*l+pos2] += conv1_w[i][j][c][d]*input[j][2*k+pos1+c][2*l+pos2+d]
                            pool1_out[j][2*k+pos1+c][2*l+pos2+d][1] += loss * conv2_w[i][j][c][d] * relupos2[i][2*k+pos1][2*l+pos2];
                            conv2_w[i][j][c][d] -= loss * pool1_out[j][2*k+pos1+c][2*l+pos2+d][0] * lr * relupos2[i][2*k+pos1][2*l+pos2];
                    }}
                   conv2_b[i] -= loss * lr * relupos2[i][2*k+pos1][2*l+pos2];
    }}}}
} 
void backward3(){
    short pos1 = 0;
    short pos2 = 0;
    float loss = 0.0f;
    for(int m = 0; m < 10; m++){
        for(int a = 0; a < 5; a++){
            for(int b = 0; b < 5; b++){
                pool2_out[m][a][b][1] = 0;
    }}}
    for(int i = 0; i < 20; i++){
        for(int j = 0; j < 10; j++){
            for(int k = 0; k < 1; k++){
                for(int l = 0; l < 1; l++){
                    pos1 = 0;
                    pos2 = 0;
                    loss = conv3_out[i][k][l][1];
                    for(int c = 0; c < 5; c++){
                        for(int d = 0; d < 5; d++){
                            //conv1_out[i][2*k+pos1][2*l+pos2] += conv1_w[i][j][c][d]*input[j][2*k+pos1+c][2*l+pos2+d]
                            pool2_out[j][2*k+pos1+c][2*l+pos2+d][1] += loss * conv3_w[i][j][c][d] * relupos3[i][2*k+pos1][2*l+pos2];
                            conv3_w[i][j][c][d] -= loss * pool2_out[j][2*k+pos1+c][2*l+pos2+d][0] * lr * relupos3[i][2*k+pos1][2*l+pos2];
                    }}
                   conv3_b[i] -= loss * lr * relupos3[i][2*k+pos1][2*l+pos2];
    }}}}
}
void fltbackward(){
    for(int i = 0; i < 20; i++){
        conv3_out[i][0][0][1] = flatten[i][1];
    }
}        
void mlpbackward1(){
    float loss = 0.0f;
    for(int a = 0; a < 20; a++){
        flatten[a][1] = 0;
    } 
    for(int i = 0; i < 30; i++){
        loss = fc1_out[i][1];
        for(int j = 0; j < 20; j++){
            flatten[j][1] += loss * fc1_w[i][j] * relupos4[i];
            fc1_w[i][j] -= loss * flatten[j][0] * lr * relupos4[i];
        }fc1_b[i] -= loss * lr * relupos4[i];
    }
}
void mlpbackward2(){
    float loss = 0.0f;
    for(int a = 0; a < 30; a++){
        fc1_out[a][1] = 0;
    }    
    for(int i = 0; i < 3; i++){
        loss = output[i][1];
        for(int j = 0; j < 30; j++){
            fc1_out[j][1] += loss * fc2_w[i][j] * relupos5[i];
            fc2_w[i][j] -= loss * fc1_out[j][0] * lr * relupos5[i];
        }fc2_b[i] -= loss * lr * relupos5[i];
    }
}            
void scheduler(){
    for(int i = 0; i < 3; i++){
        output[i][1] = losscalc(output[i][0], goal[i]) ;
    }
}        
void losscompute(){
    for(int i = 0; i < 3; i++){
        acc[i] = losscalc(output[i][0], goal[i])* losscalc(output[i][0], goal[i]);
    }
}


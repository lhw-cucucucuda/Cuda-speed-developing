void softmax(int length){
    float sum = 0.0f;
    for(int i = 0; i < length; i++){
        sum+= output[i][0];
    }
    float m = 1/sum;
    for (int j = 0; j < length; j++){
        out[j] = output[j][0] *m ;
    }               
